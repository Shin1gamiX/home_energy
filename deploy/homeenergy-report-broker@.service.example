# PREPARATION ONLY. The documentation-only IP must match config.json when approved.
[Unit]
Description=Home Energy report-only broker connection
Requires=homeenergy-report-broker.socket
After=homeenergy-report-broker.socket

[Service]
Type=exec
User=homeenergy-report-broker
Group=homeenergy-report-broker
ExecStart=/usr/bin/python3 -I -B /opt/homeenergy-report-broker/insights_broker.py
LoadCredential=report-key:/etc/homeenergy-report-credentials/report-key
StandardInput=socket
StandardOutput=null
StandardError=journal
SyslogIdentifier=homeenergy-report-broker
UMask=0077
WorkingDirectory=/
Restart=no
RuntimeMaxSec=65
TimeoutStopSec=3
KillMode=control-group
TasksMax=8
MemoryMax=96M
CPUQuota=25%
LimitNOFILE=64
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=192.0.2.10
InaccessiblePaths=-/var/www/homeenergy -/var/lib/homeenergy-reports -/opt/homeenergy-control
# No writable host paths and no model/API credentials are supplied to this service.
